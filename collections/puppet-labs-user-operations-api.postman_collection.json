          "name": "List users",
          "request": {
            "name": "List users",
            "description": {
              "content": "Provides information about Puppet Forge user accounts. By default, results are returned in alphabetical\norder by username and paginated with 20 users per page. It's also possible to sort by number of published\nreleases, total download counts for all the user's modules, or by the date of the user's latest release.\nAll parameters are optional.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v3",
                "users"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "20",
                  "description": "The numbers of items to return per page"
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "0",
                  "description": "The number of items to skip before starting to collect the result set"
                },
                {
                  "disabled": false,
                  "key": "sort_by",
                  "value": "<string>",
                  "description": "Desired order in which to return results"
                },
                {
                  "disabled": false,
                  "key": "with_html",
                  "value": "<boolean>",
                  "description": "Render markdown files (README, REFERENCE, etc.) to HTML before returning results"
                },
                {
                  "disabled": false,
                  "key": "include_fields",
                  "value": "<string>%20<string>",
                  "description": "List of top level keys to include in response object, only applies to fields marked 'optional'"
                },
                {
                  "disabled": false,
                  "key": "exclude_fields",
                  "value": "<string>%20<string>",
                  "description": "List of top level keys to exclude from response object"
                }
              ],
